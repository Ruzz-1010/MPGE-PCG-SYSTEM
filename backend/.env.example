# Copy to .env; never commit actual credentials.
DATABASE_URL=
MIGRATION_DATABASE_URL=
HOST=127.0.0.1
PORT=3000
# Set to 1 only behind a trusted local TLS reverse proxy.
TRUST_LOCAL_PROXY=0
# Bootstrap command only; remove from environment after use.
BOOTSTRAP_USERNAME=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=

# Required: random 32-byte hex MFA encryption key, kept outside Git.
VW_MFA_KEY=
VW_BROWSER_ORIGIN=https://localhost
# Only for isolated loopback demo at http://127.0.0.1:3000
VW_LOCAL_HTTP=0

# Required absolute path, outside web root, owned by API user, mode 0700.
VW_PRIVATE_DIR=
